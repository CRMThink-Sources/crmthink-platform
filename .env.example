# ─── Processo ───
NODE_ENV=development
PORT=4100
LOG_LEVEL=info
# Loki direto (dev). Em produção o Promtail coleta o stdout: deixe vazio.
LOKI_URL=

# URL pública da plataforma, sem barra final: página de instalação, handlers do Bitrix,
# JWKS e `iss` do JWT.
PUBLIC_BASE_URL=https://platform-staging.crmthink.com.br
# production | homolog — gravado no campo Ambiente dos SPAs 1060/1142/1146.
PLATFORM_ENVIRONMENT=homolog

# ─── Banco e Redis ───
DATABASE_URL=mysql://platform:platform@127.0.0.1:3307/crmthink_platform?allowPublicKeyRetrieval=true
REDIS_URL=redis://127.0.0.1:6380
QUEUE_PREFIX=crmthink-platform-staging

# ─── Segredos (obrigatórios) ───
# AES-256-GCM, 32 bytes em base64: `yarn admin:generate-encryption-key`.
# Sem ela o processo não sobe. Perder a chave = perder todos os tokens guardados.
TOKEN_ENCRYPTION_KEY=rMf5J7ULHEmX4cTMF+41QxPtunhr+J6+IBt+xT7/jvE=
# Chave privada RSA (PEM, `\n` escapado) que semeia a primeira chave de assinatura do
# JWT. Depois, rotação por `POST /admin/signing-keys/rotate`. Sem chave ativa o
# processo não sobe.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
JWT_SIGNING_PRIVATE_KEY=
# Opcional; padrão = PUBLIC_BASE_URL.
JWT_ISSUER=
JWT_TTL_SECONDS=900
# Credenciais de operador para /admin/* (separadas por vírgula).
ADMIN_API_TOKENS=

# ─── Backoffice ───
# Origens que podem fazer mutações com sessão de operador (Origin). Dev: http://localhost:5173
BACKOFFICE_ORIGINS=
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_MAX_HOURS=12
# true só em desenvolvimento sem TLS (cookie sem Secure).
ADMIN_COOKIE_INSECURE=false
ADMIN_AUDIT_RETENTION_DAYS=365

# ─── Sessão do iframe ───
# appCode=origem1,origem2;appCode2=origem3
SESSION_CORS_ORIGINS=crmthink.gptmaker=https://gptmaker-staging.crmthink.com.br

# ─── Stripe (test mode em staging, live em produção) ───
# O prefixo (`sk_live_`/`rk_live_`) decide qual campo de preço do SPA 1138 vale.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Portal CRMThink (SPAs) ───
# Webhook de entrada (crm.item.*).
CRMTHINK_WEBHOOK_URL=
# application_token do webhook de saída (onCrmDynamicItem*) → POST /bitrix/spa-events.
CRMTHINK_APPLICATION_TOKEN=
# JSON com sobrescritas de IDs de SPA, campos UF e enums (ver src/config/spa-config.ts).
SPA_CONFIG_FILE=

# ─── Ajustes ───
BITRIX_TLS_REJECT_UNAUTHORIZED=true
INSTALLER_TIMEOUT_MS=60000
WEBHOOK_TIMEOUT_MS=10000
CREDENTIAL_ROTATION_GRACE_HOURS=24
EVENT_RETRY_WINDOW_HOURS=24
WORKER_DISABLE_SCHEDULES=false
