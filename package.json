{
  "name": "crmthink-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma CRMThink: instalação Bitrix24, cofre de tokens, sessão de iframe e cobrança (Stripe + SPAs) para todas as aplicações.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start:api": "node dist/src/api.js",
    "start:worker": "node dist/src/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "lint": "yarn prisma:generate && eslint --max-warnings 0 .",
    "check-types": "yarn prisma:generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stripe": "tsx scripts/stripe-trigger-e2e.ts",
    "docs:openapi": "tsx scripts/generate-openapi.ts",
    "sdk:types": "tsx sdk/typescript/scripts/generate-types.ts --write",
    "sdk:build": "node -e \"require('fs').rmSync('sdk/typescript/dist',{recursive:true,force:true})\" && tsc -p sdk/typescript/tsconfig.build.json",
    "admin:rotate-signing-key": "tsx scripts/rotate-signing-key.ts",
    "admin:create-operator": "tsx scripts/create-operator.ts",
    "admin:generate-encryption-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "dependencies": {
    "@node-rs/argon2": "^2",
    "@prisma/adapter-mariadb": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "bullmq": "^5.76.6",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.10.1",
    "jose": "^6.1.0",
    "mariadb": "^3.4.5",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "prisma": "7.4.2",
    "prom-client": "^15.1.3",
    "stripe": "^22.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.4.0",
    "globals": "^16.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.4",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.2",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.32.0",
    "vitest": "^4.1.7"
  }
}
